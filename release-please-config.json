{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Nouveautés" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "docs", "section": "Autres", "hidden": true },
        { "type": "ci", "section": "Autres", "hidden": true },
        { "type": "refactor", "section": "Autres", "hidden": true },
        { "type": "test", "section": "Autres", "hidden": true },
        { "type": "chore", "section": "Autres", "hidden": true },
        { "type": "style", "section": "Autres", "hidden": true },
        { "type": "build", "section": "Autres", "hidden": true }
      ]
    }
  }
}
